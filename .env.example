# Copier en .env. Tout est facultatif : les valeurs par défaut conviennent en local.
PORT=3000
HOST=127.0.0.1
DATA_DIR=./data
# Code demandé une seule fois, sur la page de première connexion, pour choisir le mot de passe.
# S'il est vide, la première connexion n'est possible que depuis la machine elle-même (localhost).
SETUP_CODE=
# Facultatif : impose le mot de passe depuis l'environnement au lieu de la page de première connexion.
APP_PASSWORD=
# Adresse publique de l'application (liens dans les notifications). Déduite de la première connexion si vide.
BASE_URL=
CONTACT_EMAIL=
IMAP_POLL_MINUTES=2
# IMAP_IDLE=1 lit chaque nouvel email dès que la boîte le signale (connexion IDLE), la relecture ci-dessus ne servant plus que de filet (10 minutes au moins) ; IMAP_IDLE=0 garde la seule relecture périodique.
IMAP_IDLE=1
HTTP_POLL_MINUTES=30
# DEMO=1 charge quelques annonces d'exemple au premier démarrage si la base est vide.
DEMO=0
